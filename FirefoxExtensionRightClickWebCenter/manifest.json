{
  "manifest_version": 2,
  "name": "原生消息传递与 C++ exe 通信",
  "version": "1.0",
  "description": "无需服务器，扩展直接与 C++ exe 通信",
  "permissions": [
    "contextMenus",
    "activeTab",
    "clipboardWrite",
    "nativeMessaging"  // 新增：Native Messaging 权限
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
        "gecko": {
            "id": "tab-context-demo@yourname.com"
        }
    }
}
